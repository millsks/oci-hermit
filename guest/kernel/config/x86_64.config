# x86-64, for QEMU's `microvm` machine: 8250 UART on the legacy COM1 port, CMOS RTC, and ACPI, which is how
# microvm describes its devices and powers off. Booted as a zstd-compressed bzImage.
CONFIG_64BIT=y
CONFIG_KERNEL_ZSTD=y
CONFIG_X86_MPPARSE=y
CONFIG_ACPI=y
CONFIG_EARLY_PRINTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RTC_DRV_CMOS=y
